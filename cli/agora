#!/usr/bin/env node
// agora — CLI for agents running inside agora sessions.
//   agora notify <title> [body…] [--link <url>] [--session <id>]
//       Send the owner a notification: dashboard inbox + web push.
//       --session defaults to AGORA_SESSION_ID (injected into every session).
//
//   agora artifact <file> [--name <name>] [--ttl <days>] [--private]
//       Publish a file to ~/.agora/artifacts/ and print a signed, shareable URL.
//
// Auth: the hooks secret (~/.agora/hook-secret), same channel as the Claude
// Code hooks — anything running as the agora user may notify.
// CommonJS: installed outside the repo (~/.local/bin), no package.json nearby.
"use strict";

const crypto = require("node:crypto");
const fs = require("node:fs");
const http = require("node:http");
const os = require("node:os");
const path = require("node:path");

const env = (name) => process.env[`AGORA_${name}`];
const dataDir = env("DATA_DIR") ?? path.join(os.homedir(), ".agora");
const port = Number(env("PORT") ?? 4570);

function fail(msg) {
  console.error(`agora: ${msg}`);
  process.exit(1);
}

/** Bearer for the hook channel.
 *
 *  A session's own token, from the environment agora put it there, is preferred
 *  over the global secret on disk. The global secret authenticates ANY caller as
 *  ANY session — every command below names itself with AGORA_SESSION_ID — so
 *  reading it from a file meant any process running as this unix user could post
 *  to a project board under another agent's name. The token settles identity
 *  server-side, and the file is only the fallback for a shell that agora did not
 *  start.
 */
function secret() {
  const token = env("SESSION_TOKEN");
  if (token) return token;
  try {
    return fs.readFileSync(path.join(dataDir, "hook-secret"), "utf8").trim();
  } catch {
    fail(`no session token and no hook secret (${path.join(dataDir, "hook-secret")}) — are you inside an agora session?`);
  }
}

/**
 * One request to the agora server, over the unix socket when it is there and
 * loopback TCP otherwise.
 *
 * The socket is preferred because it is the path that survives sandboxing: a
 * session cut off from the network with --unshare-net still reaches a filesystem
 * object it was handed. It also cannot be reached by processes that were not
 * handed it, which loopback TCP cannot say. TCP stays as the fallback for a shell
 * agora did not start, and for older sessions whose environment predates this.
 *
 * The shape mimics the part of fetch() this file used, so the call sites read the
 * same: `.ok`, `.status`, `.json()`.
 */
/** Which door request() would use — so an error can name the one that failed
 *  instead of always blaming a TCP port we may not have touched. */
/** Must match config.ts socketPath(): its own directory, so that a sandboxed
 *  session can be handed the directory rather than an inode that a server
 *  restart invalidates. */
const socketPath = () => env("SOCKET") ?? path.join(dataDir, "sock", "agora.sock");

function where() {
  const sock = socketPath();
  return fs.existsSync(sock) ? `socket ${sock}` : `port ${port}`;
}

function request(pathname, opts = {}) {
  const sock = socketPath();
  const viaSocket = fs.existsSync(sock);
  const options = {
    method: opts.method ?? "GET",
    path: pathname,
    headers: opts.headers ?? {},
    ...(viaSocket ? { socketPath: sock } : { host: "127.0.0.1", port }),
  };
  return new Promise((resolve, reject) => {
    const req = http.request(options, (res) => {
      let body = "";
      res.setEncoding("utf8");
      res.on("data", (d) => (body += d));
      res.on("end", () =>
        resolve({
          ok: res.statusCode >= 200 && res.statusCode < 300,
          status: res.statusCode,
          json: async () => JSON.parse(body),
          text: async () => body,
        })
      );
    });
    // the caller reports this as "server unreachable", which is true of both doors
    req.on("error", (err) => reject(Object.assign(new Error(err.message), { cause: err })));
    if (opts.body) req.write(opts.body);
    req.end();
  });
}

/** Public origin, for printing clickable URLs. The env FILE wins over the
 *  process env: sessions inherit the tmux server's environment, frozen at
 *  whenever tmux first started — the file on disk is the current truth. */
function origin() {
  try {
    const envFile = fs.readFileSync(path.join(dataDir, "env"), "utf8");
    const m = envFile.match(/^AGORA_ORIGIN=(.+)$/m);
    if (m) return m[1].trim().replace(/^["']|["']$/g, "").replace(/\/$/, "");
  } catch {}
  const fromEnv = env("ORIGIN");
  if (fromEnv) return fromEnv.replace(/\/$/, "");
  return `http://127.0.0.1:${port}`;
}

/** Split flags (--link, --session, --name) from positionals. */
function parseArgs(argv) {
  const flags = {};
  const positional = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--link" || a === "-l") flags.link = argv[++i];
    else if (a === "--session" || a === "-s") flags.session = argv[++i];
    else if (a === "--name" || a === "-n") flags.name = argv[++i];
    else if (a === "--model" || a === "-m") flags.model = argv[++i];
    else if (a === "--harness" || a === "-H") flags.harness = argv[++i];
    else if (a === "--lines") flags.lines = argv[++i];
    else if (a === "--ttl") flags.ttl = argv[++i];
    else if (a === "--private") flags.private = true;
    else if (a === "--terminal") flags.terminal = true;
    else if (a === "--full") flags.full = true;
    else positional.push(a);
  }
  return { flags, positional };
}

async function notify(argv) {
  const { flags, positional } = parseArgs(argv);
  const [title, ...rest] = positional;
  if (!title) fail("usage: agora notify <title> [body…] [--link <url>]");
  const payload = {
    title,
    body: rest.join(" "),
    link: flags.link,
    session_id: flags.session ?? env("SESSION_ID"),
  };
  let res;
  try {
    res = await request(`/api/hooks/notify`, {
      method: "POST",
      headers: { "Content-Type": "application/json", "X-Agora-Hook": secret() },
      body: JSON.stringify(payload),
    });
  } catch (err) {
    fail(`agora server unreachable on ${where()} (${err.cause?.code ?? err.message})`);
  }
  if (!res.ok) fail(`server answered ${res.status}: ${await res.text()}`);
  console.log("notification sent");
}

async function pc(argv) {
  const { positional } = parseArgs(argv);
  const [op, target] = positional;
  if ((op !== "ls" && op !== "get") || !target) fail("usage: agora pc <ls|get> <path-on-pc>");
  let res;
  try {
    res = await request(`/api/hooks/pc`, {
      method: "POST",
      headers: { "Content-Type": "application/json", "X-Agora-Hook": secret() },
      body: JSON.stringify({ op, path: target }),
    });
  } catch (err) {
    fail(`agora server unreachable on ${where()} (${err.cause?.code ?? err.message})`);
  }
  const body = await res.json().catch(() => ({}));
  if (!res.ok) fail(body.error ?? `server answered ${res.status}`);
  if (op === "ls") {
    for (const e of body.entries) {
      console.log(`${e.dir ? "d" : "-"} ${String(e.size).padStart(10)}  ${e.name}`);
    }
  } else {
    console.log(body.path); // local path on the VPS, ready to Read
  }
}

/** Same token as server/src/auth.ts, and deploy/gate-artifacts.mjs pins that
 *  the two agree: the CLI signs, the server verifies, and a drift between the
 *  two halves would silently break every link already handed out. */
function artifactToken(name, expires) {
  const sig = crypto
    .createHmac("sha256", secret())
    .update(`artifact:${name}:${expires}`)
    .digest("base64url")
    .slice(0, 32);
  return `${expires.toString(36)}.${sig}`;
}

function artifact(argv) {
  const { flags, positional } = parseArgs(argv);
  const [file] = positional;
  if (!file) fail("usage: agora artifact <file> [--name <name>] [--ttl <days>] [--private]");
  if (!fs.existsSync(file)) fail(`file not found: ${file}`);
  let name = (flags.name ?? path.basename(file)).replace(/[^A-Za-z0-9._-]/g, "-");
  // the extension is what makes a browser RENDER the page instead of saving
  // it: with no extension the file is served as octet-stream, and the nosniff
  // header turns the link into a download. A --name without one borrows the
  // source file's, since the name is a label, not a choice of format.
  if (!path.extname(name)) name += path.extname(file);
  const dir = path.join(dataDir, "artifacts");
  fs.mkdirSync(dir, { recursive: true });
  fs.copyFileSync(file, path.join(dir, name));
  const url = `${origin()}/artifacts/${name}`;
  // signed by default: the owner opens these on a phone or from Slack, where
  // his session cookie does not exist. --private prints the bare URL, which
  // only works in a browser already logged into agora.
  if (flags.private) return console.log(url);
  const days = Number(flags.ttl ?? 30);
  if (!Number.isFinite(days) || days <= 0) fail("--ttl takes a positive number of days");
  console.log(`${url}?t=${artifactToken(name, Date.now() + days * 86400000)}`);
}

/** The project board. A post here reaches NOBODY's terminal — it is an
 *  announcement others read when it matters to them. To reach one session, use
 *  `agora send`; to read one without waking it, `agora read`. Both need a link
 *  drawn between the two terminals on the canvas. */
async function chat(argv) {
  const { flags, positional } = parseArgs(argv);
  const session = flags.session ?? env("SESSION_ID");
  if (!session) fail("AGORA_SESSION_ID missing — run inside an agora session (or pass --session)");
  const headers = { "Content-Type": "application/json", "X-Agora-Hook": secret() };
  try {
    if (positional[0] === "log") {
      const n = Number(positional[1]) || 30;
      const res = await request(`/api/hooks/chat/log?session=${encodeURIComponent(session)}&n=${n}`,
        { headers }
      );
      if (!res.ok) fail(`chat log failed: ${res.status} ${await res.text()}`);
      const { messages } = await res.json();
      if (!messages.length) console.log("(nothing on the project board yet)");
      for (const m of messages) {
        console.log(`[${new Date(m.created_at).toISOString().slice(11, 16)}] ${m.author}: ${m.body}`);
      }
    } else {
      const body = positional.join(" ").trim();
      if (!body) fail("usage: agora chat <message…> | agora chat log [n]");
      const res = await request(`/api/hooks/chat`, {
        method: "POST",
        headers,
        body: JSON.stringify({ session_id: session, body }),
      });
      if (!res.ok) fail(`chat post failed: ${res.status} ${await res.text()}`);
      const out = await res.json().catch(() => ({}));
      const woke = out.injected?.length ? ` — delivered to ${out.injected.join(", ")}` : "";
      console.log(`posted${woke}`);
      // the old reflex was "@name in a chat message reaches them". On the board
      // it no longer does, and silently doing nothing is the worst outcome.
      if (!woke && /@[\w-]+/.test(body)) {
        console.log(
          "note: an @mention here does not reach anyone — the board interrupts nobody. " +
            'To reach a linked session: agora send <name> "…", or read it without waking it: agora read <name>'
        );
      }
    }
  } catch (err) {
    fail(`agora server unreachable on ${where()} (${err.cause?.code ?? err.message})`);
  }
}

/** Write to ONE named session. Only works towards a session you are LINKED to
 *  on the canvas — the same link that lets you read it — and it costs that agent
 *  a turn, so it is a verb you type on purpose, not a mention in a sentence. */
async function ask(argv) {
  const { flags, positional } = parseArgs(argv);
  const session = flags.session ?? env("SESSION_ID");
  if (!session) fail("AGORA_SESSION_ID missing — run inside an agora session (or pass --session)");
  const [to, ...rest] = positional;
  const body = rest.join(" ").trim();
  if (!to || !body) fail('usage: agora send <session-name> "<message>"');
  let res;
  try {
    res = await request(`/api/hooks/ask`, {
      method: "POST",
      headers: { "Content-Type": "application/json", "X-Agora-Hook": secret() },
      body: JSON.stringify({ session_id: session, to, body }),
    });
  } catch (err) {
    fail(`agora server unreachable on ${where()} (${err.cause?.code ?? err.message})`);
  }
  const out = await res.json().catch(() => ({}));
  if (!res.ok) {
    fail(out.candidates ? `${out.error}: ${out.candidates.join(", ")}` : (out.error ?? `server answered ${res.status}`));
  }
  console.log(
    out.injected?.length
      ? `delivered to ${out.to}`
      : `queued for ${out.to} — it is mid-turn, it will get this when it finishes`
  );
}

/** The project board: what agents on OTHER work have announced. Nobody is
 *  interrupted by it, so reading it is on you — do it before touching shared
 *  files, and after being away for a while. */
async function board(argv) {
  const { flags, positional } = parseArgs(argv);
  const session = flags.session ?? env("SESSION_ID");
  if (!session) fail("AGORA_SESSION_ID missing — run inside an agora session (or pass --session)");
  const n = Number(positional[0]) || 30;
  let res;
  try {
    res = await request(`/api/hooks/chat/board?session=${encodeURIComponent(session)}&n=${n}`,
      { headers: { "X-Agora-Hook": secret() } }
    );
  } catch (err) {
    fail(`agora server unreachable on ${where()} (${err.cause?.code ?? err.message})`);
  }
  const out = await res.json().catch(() => ({}));
  if (!res.ok) fail(out.error ?? `server answered ${res.status}`);
  if (!out.messages?.length) return console.log("(nothing on the project board yet)");
  for (const m of out.messages) {
    const at = new Date(m.created_at).toISOString().slice(11, 16);
    const to = m.to_name ? ` -> ${m.to_name}` : "";
    console.log(`[${at}] ${m.author}${to}: ${m.body}`);
  }
}

/** Everything this session may know about its frame: brief, branch/worktree,
 *  frame-mates and the decision journal. */
async function frame(argv) {
  const { flags } = parseArgs(argv);
  const session = flags.session ?? env("SESSION_ID");
  if (!session) fail("AGORA_SESSION_ID missing — run inside an agora session (or pass --session)");
  let res;
  try {
    res = await request(`/api/hooks/frame?session=${encodeURIComponent(session)}`,
      { headers: { "X-Agora-Hook": secret() } }
    );
  } catch (err) {
    fail(`agora server unreachable on ${where()} (${err.cause?.code ?? err.message})`);
  }
  const info = await res.json().catch(() => ({}));
  if (!res.ok) fail(info.error ?? `server answered ${res.status}`);
  if (!info.frame) {
    console.log(
      `no frame — this session is loose on ${info.project}, running in ${info.cwd}.\n` +
        `It shares that checkout with the other loose sessions: no git isolation.`
    );
    return;
  }
  const f = info.frame;
  console.log(`frame: ${f.name} (${f.id})`);
  console.log(
    f.worktree
      ? `isolated: branch ${f.branch} in ${f.worktree} — reserved port ${f.port}`
      : `not isolated: runs on the shared checkout ${info.project}`
  );
  if (f.brief) console.log(`\nbrief:\n${f.brief}`);
  if (info.members?.length) {
    console.log(`\nframe-mates:`);
    for (const m of info.members) {
      console.log(`  ${m.name} (${m.harness}, ${m.state})${m.summary ? ` — ${m.summary}` : ""}`);
    }
  }
}

/** Read what a session you are LINKED to on the canvas is doing.
 *
 *  A link drawn between two terminals grants BOTH halves: reading it (`agora
 *  read`) and writing to it (`agora send`). Reading costs you a turn and the
 *  other agent nothing, so it should be your first move and `send` the fallback. */
async function peek(argv) {
  const { flags, positional } = parseArgs(argv);
  const session = flags.session ?? env("SESSION_ID");
  if (!session) fail("AGORA_SESSION_ID missing — run inside an agora session (or pass --session)");
  const target = positional[0];
  const mode = flags.terminal ? "terminal" : flags.full ? "transcript" : "summary";
  const qs = new URLSearchParams({ session, mode });
  if (target) qs.set("target", target);
  if (flags.lines) qs.set("lines", flags.lines);
  let res;
  try {
    res = await request(`/api/hooks/peek?${qs}`, {
      headers: { "X-Agora-Hook": secret() },
    });
  } catch (err) {
    fail(`agora server unreachable on ${where()} (${err.cause?.code ?? err.message})`);
  }
  const out = await res.json().catch(() => ({}));
  if (!res.ok) fail(out.candidates ? `${out.error}: ${out.candidates.join(", ")}` : (out.error ?? `server answered ${res.status}`));
  if (!target) {
    if (!out.linked?.length) {
      return console.log(
        "not linked to anyone — a human links two terminals on the canvas (Link tool, or L) to let them read and message each other"
      );
    }
    console.log("linked sessions you may read:");
    for (const l of out.linked) {
      console.log(`  ${l.name} (${l.harness}, ${l.state})${l.summary ? ` — ${l.summary}` : ""}`);
    }
    console.log('\nread one with: agora read <name> [--full | --terminal] · write with: agora send <name> "…"');
    return;
  }
  console.log(`--- ${out.name} (${out.mode}) ---`);
  console.log(out.text || out.note || "(nothing to show)");
}

/** Summon a sub-agent session on this project. It appears on the canvas
 *  linked to this session, gets a mythology name, and shares the chat. */
async function spawn(argv) {
  const { flags, positional } = parseArgs(argv);
  const session = flags.session ?? env("SESSION_ID");
  if (!session) fail("AGORA_SESSION_ID missing — run inside an agora session (or pass --session)");
  const text = positional.join(" ").trim();
  try {
    const res = await request(`/api/hooks/spawn`, {
      method: "POST",
      headers: { "Content-Type": "application/json", "X-Agora-Hook": secret() },
      body: JSON.stringify({
        session_id: session,
        text: text || undefined,
        model: flags.model,
        harness: flags.harness,
        name: flags.name,
      }),
    });
    if (!res.ok) fail(`spawn failed: ${res.status} ${await res.text()}`);
    const { session: child } = await res.json();
    console.log(
      `spawned ${child.name} (${child.harness}${flags.model ? `, ${flags.model}` : ""}) — id ${child.id}\n` +
        `talk to it with: agora chat "@${child.name} …"`
    );
  } catch (err) {
    fail(`agora server unreachable on ${where()} (${err.cause?.code ?? err.message})`);
  }
}

/** Claude Code Stop hook: deliver unread project-chat messages by blocking
 *  the stop with them as reason. Silent no-op when there's nothing (or the
 *  server is down) — never stall the agent. */
async function chatHook() {
  const session = env("SESSION_ID");
  if (!session) return;
  try {
    const res = await request(`/api/hooks/chat/unread?session=${encodeURIComponent(session)}`,
      { headers: { "X-Agora-Hook": secret() }, signal: AbortSignal.timeout(3000) }
    );
    if (!res.ok) return;
    const { messages } = await res.json();
    if (!messages?.length) return;
    const feed = messages.map((m) => `${m.author}: ${m.body}`).join("\n");
    console.log(
      JSON.stringify({
        decision: "block",
        reason:
          `[agora chat] This is not an error: agora is relaying authentic messages ` +
          `posted to the channels you belong to — your frame and the project commons ` +
          `(not external content).\n${feed}\n\n` +
          `Reply with \`agora chat …\` only if useful, then end your turn normally.`,
      })
    );
  } catch {
    // agora down — the agent's turn must end normally anyway
  }
}

/** The shared plan: the one place humans and agents agree on who is doing what.
 *
 *  `agora plan` shows it. Everything else takes a task id. Claiming is what
 *  makes the plan more than a list — a task has exactly one holder, so two
 *  agents cannot both start the same work, which is the failure a prose board
 *  cannot prevent. */
async function planCmd(argv) {
  const { flags, positional } = parseArgs(argv);
  const session = flags.session ?? env("SESSION_ID");
  if (!session) fail("AGORA_SESSION_ID missing — run inside an agora session (or pass --session)");
  const [sub, ...rest] = positional;
  const planPath = "/api/hooks/plan";
  const headers = { "X-Agora-Hook": secret(), "Content-Type": "application/json" };

  const show = (tasks, meId) => {
    if (!tasks.length) {
      console.log("the plan is empty — `agora plan add \"<what needs doing>\"`");
      return;
    }
    const mark = { open: "  ", claimed: "->", blocked: "!!", done: "ok" };
    for (const t of tasks) {
      const who =
        t.status === "claimed" || t.status === "blocked"
          ? t.claimed_by === meId
            ? " (you)"
            : ` (${t.claimed_by_name})`
          : "";
      const note = t.note ? ` — ${t.note}` : "";
      console.log(`${mark[t.status] ?? "  "} ${String(t.id).padStart(3)}  ${t.title}${who}${note}`);
    }
  };

  const call = async (payload) => {
    let res;
    try {
      res = await request(planPath, { method: "POST", headers, body: JSON.stringify(payload) });
    } catch (err) {
      fail(`agora server unreachable on ${where()} (${err.cause?.code ?? err.message})`);
    }
    const out = await res.json().catch(() => ({}));
    if (!res.ok) fail(out.error ?? `server answered ${res.status}`);
    return out;
  };

  if (!sub || sub === "ls") {
    let res;
    try {
      res = await request(`${planPath}?session=${encodeURIComponent(session)}`, { headers });
    } catch (err) {
      fail(`agora server unreachable on ${where()} (${err.cause?.code ?? err.message})`);
    }
    const out = await res.json().catch(() => ({}));
    if (!res.ok) fail(out.error ?? `server answered ${res.status}`);
    show(out.tasks ?? [], out.me?.id);
    return;
  }

  if (sub === "add") {
    const title = rest.join(" ").trim();
    if (!title) fail('usage: agora plan add "<what needs doing>"');
    const { task } = await call({ session, action: "add", title });
    console.log(`added ${task.id}: ${task.title}`);
    return;
  }

  const id = Number(rest[0]);
  if (!Number.isInteger(id)) fail(`usage: agora plan ${sub} <id>`);
  if (sub === "claim") {
    const { task, inherited } = await call({ session, action: "claim", id });
    console.log(`you hold ${task.id}: ${task.title}`);
    // whatever the previous holder left behind — read it before starting, it is
    // the only thing that survived their session
    if (inherited) console.log(`  handed over: ${inherited}`);
    return;
  }
  if (sub === "done") {
    const note = rest.slice(1).join(" ").trim();
    const { task } = await call({ session, action: "done", id, note });
    console.log(`done ${task.id}: ${task.title}`);
    if (note) console.log(`  left for whoever picks this up: ${note}`);
    return;
  }
  if (sub === "drop") {
    const { task } = await call({ session, action: "drop", id });
    console.log(`released ${task.id}: ${task.title}`);
    return;
  }
  if (sub === "block") {
    const note = rest.slice(1).join(" ").trim();
    if (!note) fail('usage: agora plan block <id> "<why>"');
    const { task } = await call({ session, action: "block", id, note });
    console.log(`blocked ${task.id}: ${task.title} — ${note}`);
    return;
  }
  fail("usage: agora plan [ls|add|claim|done|drop|block]");
}

async function main() {
  const [cmd, ...rest] = process.argv.slice(2);
  switch (cmd) {
    case "chat-hook":
      await chatHook();
      break;
    case "spawn":
      await spawn(rest);
      break;
    case "notify":
      await notify(rest);
      break;
    case "chat":
      await chat(rest);
      break;
    case "send":
    case "ask": // kept: sessions launched before the rename still call it
      await ask(rest);
      break;
    case "board":
      await board(rest);
      break;
    case "read":
    case "peek": // kept: sessions launched before the rename still call it
      await peek(rest);
      break;
    case "artifact":
      artifact(rest);
      break;
    case "pc":
      await pc(rest);
      break;
    case "plan":
      await planCmd(rest);
      break;
    default:
      console.log(
        [
          "agora — tools for agents inside agora sessions",
          "",
          "  agora notify <title> [body…] [--link <url>]    notify the owner (inbox + push)",
          "  agora chat <message…>                          announce on the project board (wakes nobody)",
          "  agora board [n]                                read the board (last n messages)",
          '  agora send <name> "<message>"                  write to a LINKED session (wakes it)',
          "  agora read [name] [--terminal|--full]          read a LINKED session without waking it",
          "  agora spawn <prompt…> [--model m] [--harness h] [--name n]",
          "                                                 summon a sub-agent session (canvas-linked)",
          "  agora plan                                     the shared plan: who is doing what",
          '  agora plan add "<what needs doing>"            add a task',
          "  agora plan claim|drop <id>                     take a task, or let it go",
          '  agora plan done <id> ["what to know"]          finish it, leaving a handoff behind',
          '  agora plan block <id> "<why>"                  say it is stuck, and why',
          "  agora artifact <file> [--name <n>] [--private] publish an artifact, print a shareable URL",
          "  agora pc <ls|get> <path>                       browse/fetch files from the owner's PC",
        ].join("\n")
      );
      process.exit(cmd ? 1 : 0);
  }
}

main();
