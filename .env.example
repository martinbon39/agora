# agora configuration — copy to the env file your deployment reads and edit.
#
#   systemd:  ~/.agora/env      (agora.service names it in EnvironmentFile)
#   agoractl: ~/.agora/env      (same file, or point AGORA_ENV_FILE elsewhere)
#   dev:      export these in your shell, or use a .env loader of your choice
#
# Format is plain KEY=VALUE, no quotes, no `export` — systemd parses it too.
# Every variable is optional: agora boots with none of them set and serves
# http://localhost:4570.

# --- network --------------------------------------------------------------

# Address the server binds to. Keep the loopback default when a reverse proxy
# (Caddy/nginx) terminates TLS in front of agora. 0.0.0.0 exposes it directly.
#AGORA_HOST=127.0.0.1
#AGORA_PORT=4570

# Public URL agora is served from. REQUIRED for any real deployment: passkeys
# are cryptographically bound to this hostname and Google OAuth redirects back
# to it. Leaving it unset in production does not fail loudly — logins simply
# never work, because the browser is asked for a credential scoped to
# "localhost". No trailing slash.
#AGORA_ORIGIN=https://agora.example.com

# Extra origins agora also answers on, comma-separated. Use during a domain
# migration so passkeys keep working on both names. Each one must also be
# registered as an authorized redirect URI in the Google console.
#AGORA_EXTRA_ORIGINS=https://old.example.com

# --- storage --------------------------------------------------------------

# Where agora keeps its own state: SQLite db, session logs, generated secrets,
# uploads, artifacts. Defaults to ~/.agora.
#AGORA_DATA_DIR=/home/agora/.agora

# Root under which your code lives. New sessions default their working
# directory here, and the file explorer refuses to leave it.
#AGORA_PROJECTS_DIR=/home/agora/projects

# tmux server socket (`tmux -L <name>`) agora runs its sessions on, kept
# separate from your own tmux and from any other cockpit on the same box. Changing it on a live install orphans every
# running session.
#AGORA_TMUX_SOCKET=agora

# --- identity -------------------------------------------------------------

# Your Google account address. Signing in with this address grants owner
# rights; every other address must be invited. Only used when Google sign-in
# is configured — passkey enrollment needs none of this.
#AGORA_ALLOWED_EMAIL=you@example.com

# Display name shown next to your cursor and messages.
# Defaults to the local part of AGORA_ALLOWED_EMAIL, else "owner".
#AGORA_OWNER_NAME=Ada

# --- optional integrations ------------------------------------------------

# Google OAuth client (console.cloud.google.com → APIs & Services →
# Credentials → OAuth client ID → Web application). Authorized redirect URI
# must be exactly <AGORA_ORIGIN>/api/auth/google/callback. Requested scopes are
# openid, email and profile. Sign-in with Google stays hidden unless the id,
# the secret AND AGORA_ALLOWED_EMAIL are all set. Required for guest invites.
#AGORA_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
#AGORA_GOOGLE_CLIENT_SECRET=

# Groq API key, for push-to-talk dictation (Whisper). Without it the mic
# button is inert. May also be placed in <AGORA_DATA_DIR>/groq.key instead.
#GROQ_API_KEY=

# Not configured here: the hook secret, the PC-bridge token and the web-push
# VAPID keypair are generated on first run and stored under AGORA_DATA_DIR.

# Open signup: any Google account with a verified address becomes a tenant of
# its own — their own workspace directory, their own projects, and no access to
# anyone else's. Off by default: configuring OAuth on a personal install must
# not start letting strangers in. With this set, AGORA_ALLOWED_EMAIL is
# optional (there is no single owner of a multi-tenant install).
#AGORA_OPEN_SIGNUP=1

# Sandboxing acknowledgement. With AGORA_OPEN_SIGNUP on, agora refuses to start
# unless this is set, because a session is still an ordinary process under the
# server's unix user: it can read this account's home directory (including
# agora's own database and secrets) and reach every service on loopback.
# AGORA_SANDBOX=none means "I know, these users are colleagues". There is no
# value yet that makes it actually sandboxed — that work is not done.
#AGORA_SANDBOX=none

# Unix socket the agents' own traffic uses. Defaults to <AGORA_DATA_DIR>/agora.sock,
# created 0600 on boot and removed on shutdown. Two reasons it exists: loopback TCP
# is reachable by every process on the machine and a 0600 socket is not, and it is
# the only way a session with its network unshared can still reach agora. The CLI
# prefers it and falls back to AGORA_PORT when it is absent.
#AGORA_SOCKET=/home/agora/.agora/agora.sock
