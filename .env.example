# argos configuration — copy to the env file your deployment reads and edit.
#
#   systemd:  ~/.orbit/env      (argos.service names it in EnvironmentFile)
#   argosctl: ~/.orbit/env      (same file, or point ARGOS_ENV_FILE elsewhere)
#   dev:      export these in your shell, or use a .env loader of your choice
#
# Format is plain KEY=VALUE, no quotes, no `export` — systemd parses it too.
# Every variable is optional: argos boots with none of them set and serves
# http://localhost:4560. Each also accepts a legacy ORBIT_ prefix.

# --- network --------------------------------------------------------------

# Address the server binds to. Keep the loopback default when a reverse proxy
# (Caddy/nginx) terminates TLS in front of argos. 0.0.0.0 exposes it directly.
#ARGOS_HOST=127.0.0.1
#ARGOS_PORT=4560

# Public URL argos is served from. REQUIRED for any real deployment: passkeys
# are cryptographically bound to this hostname and Google OAuth redirects back
# to it. Leaving it unset in production does not fail loudly — logins simply
# never work, because the browser is asked for a credential scoped to
# "localhost". No trailing slash.
#ARGOS_ORIGIN=https://argos.example.com

# Extra origins argos also answers on, comma-separated. Use during a domain
# migration so passkeys keep working on both names. Each one must also be
# registered as an authorized redirect URI in the Google console.
#ARGOS_EXTRA_ORIGINS=https://old.example.com

# --- storage --------------------------------------------------------------

# Where argos keeps its own state: SQLite db, session logs, generated secrets,
# uploads, artifacts. Defaults to ~/.orbit (the pre-rename name, kept because
# live sessions hold absolute paths into it).
#ARGOS_DATA_DIR=/home/argos/.orbit

# Root under which your code lives. New sessions default their working
# directory here, and the file explorer refuses to leave it.
#ARGOS_PROJECTS_DIR=/home/argos/projects

# tmux server socket (`tmux -L <name>`) argos runs its sessions on, kept
# separate from your own tmux. Changing it on a live install orphans every
# running session.
#ARGOS_TMUX_SOCKET=orbit

# --- identity -------------------------------------------------------------

# Your Google account address. Signing in with this address grants owner
# rights; every other address must be invited. Only used when Google sign-in
# is configured — passkey enrollment needs none of this.
#ARGOS_ALLOWED_EMAIL=you@example.com

# Display name shown next to your cursor and messages.
# Defaults to the local part of ARGOS_ALLOWED_EMAIL, else "owner".
#ARGOS_OWNER_NAME=Ada

# --- optional integrations ------------------------------------------------

# Google OAuth client (console.cloud.google.com → APIs & Services →
# Credentials → OAuth client ID → Web application). Authorized redirect URI
# must be exactly <ARGOS_ORIGIN>/api/auth/google/callback. Requested scopes are
# openid, email and profile. Sign-in with Google stays hidden unless the id,
# the secret AND ARGOS_ALLOWED_EMAIL are all set. Required for guest invites.
#ARGOS_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
#ARGOS_GOOGLE_CLIENT_SECRET=

# Groq API key, for push-to-talk dictation (Whisper). Without it the mic
# button is inert. May also be placed in <ARGOS_DATA_DIR>/groq.key instead.
#GROQ_API_KEY=

# Not configured here: the hook secret, the PC-bridge token and the web-push
# VAPID keypair are generated on first run and stored under ARGOS_DATA_DIR.
