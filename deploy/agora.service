# /etc/systemd/system/agora.service
[Unit]
Description=agora — self-hosted agent session cockpit
After=network.target

[Service]
Type=simple
User=agora
WorkingDirectory=/home/agora/apps/agora
ExecStart=/usr/bin/node server/dist/index.js
Restart=always
RestartSec=3
Environment=AGORA_HOST=127.0.0.1
Environment=AGORA_PORT=4570
# Set to the public URL served by Caddy (required for passkeys):
Environment=AGORA_ORIGIN=https://agora.example.com
# Optional overrides (google oauth etc.) — plain KEY=VALUE lines:
EnvironmentFile=-/home/agora/.agora/env

# NB: no PrivateTmp — the tmux server socket lives in /tmp and must be shared.
# KillMode=process: restarting agora must never kill the tmux sessions it
# spawned (they carry the user's long-running agents).
NoNewPrivileges=true
KillMode=process

[Install]
WantedBy=multi-user.target
